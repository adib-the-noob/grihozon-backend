# Copy this file to .env and update with your values
# ========================================

# ===== DATABASE =====
POSTGRES_DB=grihozon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django Database Connection (should match PostgreSQL settings above)
DB_NAME=grihozon
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost          # localhost for local, db (container name) for Docker
DB_PORT=5432

# ===== REDIS/CELERY =====
CELERY_BROKER_URL=redis://localhost:6379/0       # localhost for local, redis (container name) for Docker
CELERY_RESULT_BACKEND=redis://localhost:6379/0   # localhost for local, redis (container name) for Docker

# ===== DJANGO =====
DEBUG=True                                         # False in production
SECRET_KEY=django-insecure-v4ee=x8wwfg2%40#t@*#c1=475*r_#^6i^u*@ihcxy-ymy2o=4

# ALLOWED_HOSTS: comma-separated, NO SPACES between values
# Development examples:
#   ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost
# Production examples:
#   ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost

# ===== SETTINGS MODULE =====
# local  = Development (DEBUG=True)
# prod   = Production (DEBUG=False)
DJANGO_SETTINGS_MODULE=config.settings.local
